{
  "name": "tdw-browser-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Internal Chrome companion for Team Delivery Workspace",
  "engines": {
    "node": ">=20.11",
    "npm": ">=10"
  },
  "scripts": {
    "clean": "node ./scripts/clean.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "node ./scripts/build.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "demo": "node ./scripts/demo-server.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.9",
    "@types/node": "^26.5.1",
    "esbuild": "^0.27.3",
    "jsdom": "^27.4.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.4"
  }
}
